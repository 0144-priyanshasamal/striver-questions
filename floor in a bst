int findFloor(TreeNode* root, int x) {
    int floor = -1;

    while (root != NULL) {
        if (root->val == x) {
            return root->val;
        }

        if (root->val > x) {
            root = root->left;
        } else {
            floor = root->val;
            root = root->right;
        }
    }

    return floor;
}
