vector<int> topView(Node *root) {
    vector<int> ans;
    if (!root) return ans;

    map<int, int> mp;              // HD -> node value
    queue<pair<Node*, int>> q;     // node, HD

    q.push({root, 0});

    while (!q.empty()) {
        auto it = q.front();
        q.pop();

        Node* node = it.first;
        int hd = it.second;

        // first node at this HD
        if (mp.find(hd) == mp.end()) {
            mp[hd] = node->data;
        }

        if (node->left)
            q.push({node->left, hd - 1});

        if (node->right)
            q.push({node->right, hd + 1});
    }

    for (auto it : mp)
        ans.push_back(it.second);

    return ans;
}
