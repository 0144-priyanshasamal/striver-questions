class Solution {
public:
    int findKRotation(vector<int>& nums) {
        int low = 0, high = nums.size() - 1;

        while (low < high) {
            int mid = low + (high - low) / 2;

            if (nums[mid] > nums[high]) {
                low = mid + 1;   // min is in right half
            } else {
                high = mid;      // min is in left half
            }
        }
        // low == index of minimum element
        return low;
    }
};
