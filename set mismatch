class Solution {
public:
    vector<int> findErrorNums(vector<int>& nums) {
        int n =nums.size();
        vector<int> freq(n+1,0);
        for(int x:nums){
            freq[x]++;
        }
        int mismatch, repeation;
        for(int i=1;i<=n;i++){
        if(freq[i]==0) mismatch=i;
        if(freq[i]==2) repeation=i;
    }
    return{repeation,mismatch};
    }
};
