#include <iostream>
#include <vector>
using namespace std;

void DFS(int v, vector<vector<int>> &adj, vector<bool> &visited) {
    visited[v] = true;
    cout << v << " ";

    for (int u : adj[v]) {
        if (!visited[u]) {
            DFS(u, adj, visited);
        }
    }
}

int main() {
    int V = 6;
    vector<vector<int>> adj(V);

    
    adj[0] = {1, 2};
    adj[1] = {0, 3, 4};
    adj[2] = {0, 5};
    adj[3] = {1};
    adj[4] = {1};
    adj[5] = {2};

    vector<bool> visited(V, false);
    DFS(0, adj, visited);

    return 0;
}
