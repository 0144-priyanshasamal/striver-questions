class Solution {
public:
    int findMin(vector<int>& nums) {
        int low = 0, high = nums.size() - 1;

        while (low < high) {
            int mid = low + (high - low) / 2;

            if (nums[mid] <= nums[high]) {
                high = mid;      // min is on left or at mid
            } else {
                low = mid + 1;   // min is on right
            }
        }
        return nums[low];
    }
};
