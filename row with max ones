int rowWithMax1s(vector<vector<int>> &mat) {
    int n = mat.size();
    int m = mat[0].size();
    
    int maxOnes = 0;
    int ans = -1;

    for(int i = 0; i < n; i++) {
        int low = 0, high = m - 1;
        int firstOne = m; // assume no 1 present

        while(low <= high) {
            int mid = (low + high) / 2;
            if(mat[i][mid] == 1) {
                firstOne = mid;
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }

        int onesCount = m - firstOne;
        if(onesCount > maxOnes) {
            maxOnes = onesCount;
            ans = i;
        }
    }

    return ans;
}
